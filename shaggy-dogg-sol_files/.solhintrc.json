{
  "extends": "solhint:recommended",
  "plugins": ["prettier"],
  "rules": {
    "compiler-version": ["error", "^0.8.28"],
    "const-name-snakecase": "warn",
    "constructor-syntax": "error",
    "func-visibility": ["error", { "ignoreConstructors": true }],
    "gas-custom-errors": "error",
    "max-line-length": ["warn", 120],
    "max-states-count": ["warn", 15],
    "no-console": "off",
    "no-empty-blocks": "error",
    "no-global-import": "warn",
    "no-unused-vars": "warn",
    "not-rely-on-time": "off",
    "ordering": "warn",
    "payable-fallback": "error",
    "reason-string": ["warn", { "maxLength": 64 }],
    "var-name-mixedcase": "warn",
    "avoid-low-level-calls": "warn",
    "avoid-suicide": "error",
    "avoid-sha3": "warn",
    "no-inline-assembly": "off",
    "code-complexity": ["warn", 8],
    "function-max-lines": ["warn", 50],
    "custom-errors": "error",
    "named-parameters-mapping": "warn",
    "immutable-vars-naming": ["warn", { "immutablesAsConstants": false }],
    "one-contract-per-file": "warn",
    "use-forbidden-name": "error",
    "private-vars-leading-underscore": "warn",
    "func-name-mixedcase": "error",
    "explicit-types": ["warn", "always"]
  }
}
