# Server/daemon configuration only. Use a provider that explicitly supports Base
# private transaction submission. Chain ID validation does not prove privacy.
PRIVATE_BASE_RPC_HTTP=
PRIVATE_BASE_RPC_PROVIDER=alchemy
# For QuickNode, confirm the MEV toggle is enabled before setting this true.
PRIVATE_BASE_MEV_ENABLED=false
REQUIRE_PRIVATE_BASE_RPC=true
# Browser wallet writes use the wallet's RPC. Changing the app's read RPC does
# not change wallet transaction submission or confer MEV protection.
