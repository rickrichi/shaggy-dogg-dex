# ─────────────────────────────────────────────────────────────────────────────
# SHAGGY MUTT DEX — 24/7 AUTONOMOUS AI ARBITRAGE BOT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT SECURITY GUIDELINE:
# Never use your primary deployer or personal wallet for the bot.
# Generate a dedicated hot-wallet operator key with only a small amount of
# ETH for Base L2 gas fees (e.g. 0.005 ETH is enough for hundreds of L2 txs).
# ─────────────────────────────────────────────────────────────────────────────

# Dedicated Operator Private Key (0x-prefixed 64 hex characters)
# Leave blank to run in Dry-Run simulation mode.
OPERATOR_PRIVATE_KEY=

# Base Mainnet RPC Endpoints
BASE_RPC_HTTP=https://mainnet.base.org
BASE_RPC_WS=wss://base-rpc.publicnode.com

# Anti-Loss Profit & Risk Parameters
# Minimum required net profit in USD per trade (trades under this are skipped)
MIN_NET_PROFIT_USD=5.0

# Maximum price slippage tolerance in basis points (20 bps = 0.20%)
MAX_SLIPPAGE_BPS=20

# Maximum Base gas fee ceiling in Gwei (skips block if gas fee exceeds this)
MAX_GAS_GWEI=0.01

# Capital Allocation
# ETH to route through Triangular Arbitrage cycles
TRADE_CAPITAL_ETH=2.0

# Capital to borrow uncollateralized via Aave v3 Flash Loans (USDC)
FLASH_BORROW_USDC=50000

# VIP Staking Fee Discount Tier (0 = 0%, 1 = 10%, 2 = 25%, 3 = 50%, 4 = 100%)
VIP_TIER=3

# Target AaveFlashBorrower Contract on Base Mainnet
AAVE_BORROWER_ADDRESS=0x936a3D52c3037848879F3641dfBc9132aAe51bDF

# Active Strategies (true / false)
STRATEGY_TRIANGULAR=true
STRATEGY_CROSS_DEX=true
STRATEGY_FLASH_LOAN=true
