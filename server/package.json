{
  "name": "shaggy-dogg-server",
  "version": "1.0.0",
  "description": "Shaggy Dogg DEX backend API (Hono 4.x, Node 20+, TypeScript ESM)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --minify --clean",
    "build:tsc": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.2",
    "dotenv": "^17.2.2",
    "hono": "^4.10.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
