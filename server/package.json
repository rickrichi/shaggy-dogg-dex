{
  "name": "shaggy-dogg-server",
  "version": "1.0.0",
  "description": "Shaggy Dogg DEX backend API (Hono, Node 20, ESM)",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.10.0" },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --minify --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@hono/zod-validator": "^0.7.2",
    "dotenv": "^17.2.2",
    "hono": "^4.9.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
