# Required for browser calls to /api (dev Vite; change per environment)
ORIGIN=http://localhost:5173
PORT=8787

# Optional paid key:

# Webhook secret (optional until you enable DB webhooks)
# SUPABASE_WEBHOOK_SECRET=whsec_change_me

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Admin panel: wallets allowed to sign in (comma-separated). Empty = admin sign-in disabled.
ADMIN_WALLETS=
# ADMIN_DB_PATH=data/admin.sqlite
# ADMIN_SESSION_HOURS=8
# Launchpad launch tracking: Base RPC for verifying reported launches, and its SQLite file.
# BASE_RPC_URL=https://mainnet.base.org
# Sponsored Base portfolio transfers with MRWD rewards (all required to activate):
# PAYMASTER_ADDRESS=0x... deployed SponsoredRewardPaymaster
# PAYMASTER_SIGNER_PRIVATE_KEY=0x... server-only signing key; public address goes in deploy form
# PAYMASTER_BUNDLER_URL=https://api.pimlico.io/v2/8453/rpc?apikey=... (server-only)
# PAYMASTER_ALLOWED_WALLETS=0x... comma-separated enrolled wallet addresses
# LAUNCH_DB_PATH=data/launches.sqlite
# Keep launch records in Supabase instead of SQLite (set both, server-side only):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

MARKET_DATA_URL=http://localhost:8010
# Prices come only from Shaggy Dogg Crypto Market-Data
