# Standalone Shaggy-Dogg RPC service. Never put upstream credentials in VITE variables.
SHAGGY_RPC_PORT=8790
SHAGGY_RPC_DB=data/rpc.sqlite
# Default: your own Base execution node on loopback. A provider HTTPS URL also works.
SHAGGY_RPC_UPSTREAM=http://127.0.0.1:8545
SHAGGY_RPC_ORIGINS=http://localhost:5173,http://127.0.0.1:5174
SHAGGY_RPC_ALLOW_SEND=false
