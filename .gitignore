.next/
.next/cache/
out/
.vercel/

# ── Env files (keep example checked in) ──────────────────────────────────────
.env
.env.local
.env.deployer
.env.bot
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── Package manager lockfiles ────────────────────────────────────────────────
# Keep EXACTLY ONE lockfile (commit it) depending on your PM:
# pnpm:
pnpm-lock.yaml
# yarn:
# yarn.lock
# npm:
# package-lock.json

# If you're standardizing on pnpm, ensure you DO NOT ignore pnpm-lock.yaml.
# (You had package-lock.json ignored; that's fine if you're not using npm.)

