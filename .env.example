# Analytics defaults
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_BACKEND_ENABLED=true
VITE_ANALYTICS_GA_ENABLED=true
VITE_ANALYTICS_MIXPANEL_ENABLED=true
VITE_ANALYTICS_RESPECT_DNT=true
VITE_ANALYTICS_REQUIRE_CONSENT=true
VITE_ANALYTICS_REDACT_UA=false
VITE_ANALYTICS_REDACT_REFERRER=false
VITE_ANALYTICS_MAX_QUEUE=500

# Optional overrides
# VITE_ANALYTICS_FORCE=false

# AMM fork testing (shell/Foundry only; never prefix these with VITE_)
# Start a local Anvil fork with MAINNET_RPC_URL, then set:
# AMM_FORK_RPC_URL=http://127.0.0.1:8545
#
# AMM profiles are explicit and plan-only. Do not add wallet keys,
# private RPC credentials, or execution switches to browser configuration.

# Optional browser-safe, read-only endpoint for mainnet pair discovery.
# VITE_MAINNET_PUBLIC_RPC_URL=https://your-public-readonly-rpc.example
