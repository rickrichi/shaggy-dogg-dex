// tsconfig.node.json
{
  "compilerOptions": {
    /* Node-side targets */
    "target": "ES2022",
    "lib": ["ES2023"],

    /* ESM + bundler-style resolution */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    /* Project reference target (no output needed) */
    "composite": true,
  
    /* TS ergonomics */
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Linting/strictness for tooling */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Types: Node only here */
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
