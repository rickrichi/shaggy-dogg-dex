{
  "name": "shaggy-dogg-dex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "abi:sync": "tsx scripts/sync-abis.ts",
    "contracts:verify": "node scripts/verify-contract-sources.mjs",
    "contracts:compile": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:test:amm-fork": "forge test --root contracts --match-path test/AmmFork.t.sol -vvv",
    "contracts:test:v3-fork": "forge test --root contracts --match-contract UniswapV3BaseForkTest -vv",
    "contracts:check": "npm run contracts:verify && npm run contracts:compile && npm run contracts:test",
    "rewards:epoch": "tsx scripts/calculate-epoch-rewards.ts",
    "rewards:promote": "tsx scripts/promote-reward-epoch.ts",
    "rewards:e2e": "tsx scripts/test-reward-e2e.ts",
    "dev": "concurrently -k -n \"vite,api\" -c \"cyan,magenta\" \"vite\" \"npm --prefix server run dev\"",
    "dev:vite": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "preview": "vite preview",
    "api:dev": "npm --prefix server run dev",
    "api:start": "npm --prefix server run start",
    "script:block": "tsx scripts/getBlock.ts",
    "bot:arbitrage": "tsx scripts/arbitrage-bot-daemon.ts",
    "bot:arbitrage:dry-run": "tsx scripts/arbitrage-bot-daemon.ts --dry-run",
    "test": "vitest",
    "amm:plan:test": "vitest run src/lib/amm/plans.test.ts --reporter=dot",
    "amm:mainnet-readiness:test": "vitest run src/lib/amm/mainnet-readiness.test.ts --reporter=dot",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "dex:artifacts": "node scripts/generate-dex-artifacts.mjs",
    "dex:test:base-fork": "forge test --root contracts --match-contract OwnDexTest -vv",
    "desktop:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build-backend.ps1",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:pack": "node desktop/build-ui.mjs && electron-builder --config desktop/electron-builder.json --win --dir",
    "desktop:installer": "node desktop/build-ui.mjs && electron-builder --config desktop/electron-builder.json --win nsis",
    "routing:check": "tsx scripts/check-private-routing.ts",
    "router:check": "tsx scripts/router-check.ts",
    "desktop:release": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/release.ps1"
  },
  "overrides": {
    "zod": "^4.6.7",
    "abitype": {
      "zod": "^4.6.7"
    },
    "brace-expansion@1.x": "^1.1.21",
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1",
    "ws@8.x": "^8.21.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@wagmi/chains": "^1.8.0",
    "@wagmi/connectors": "^5.11.2",
    "@wagmi/core": "^2.21.2",
    "abitype": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "framer-motion": "^12.23.24",
    "highlight.js": "^11.9.0",
    "hono": "^4.10.6",
    "input-otp": "^1.2.4",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.462.0",
    "marked": "^12.0.2",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "viem": "^2.39.0",
    "wagmi": "^2.19.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "^4.1.12",
    "@wagmi/cli": "^2.8.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^10.0.6",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "globals": "^15.15.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.47",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "solc": "0.8.36",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.7",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^4.1.12"
  }
}
