# Production defaults (toggle as needed)
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_BACKEND_ENABLED=true
VITE_ANALYTICS_GA_ENABLED=true
VITE_ANALYTICS_MIXPANEL_ENABLED=true
VITE_ANALYTICS_RESPECT_DNT=true
VITE_ANALYTICS_REQUIRE_CONSENT=true
VITE_ANALYTICS_REDACT_UA=false
VITE_ANALYTICS_REDACT_REFERRER=true
VITE_ANALYTICS_MAX_QUEUE=1000
VITE_ANALYTICS_FORCE=false

# SSR client entry (from dist/.vite/manifest.json after build)
SSR_CLIENT_ENTRY=/js/index-C-xbZVap.js

# API base for diagnostics (adjust to your deployed API)
VITE_API_URL=https://api.lumsian.com

# --- RPC Providers (Alchemy) ---

# --- WalletConnect & 0x ---
VITE_WALLETCONNECT_PROJECT_ID=201e649b61c74e9bd7ed7f414b5976f2

# --- Base Network Routers ---
VITE_UNISWAP_V2_ROUTER=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24
VITE_AERODROME_ROUTER=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
VITE_AERODROME_FACTORY=0x420DD381b31aEf6683db6B902084cB0FFECe40Da
VITE_ATOMIC_ROUTER_ADDRESS=0xdF77eBFB6e0468aE4e94b13Fc9881427B82178Fd
VITE_YIELD_VAULT_ADDRESS=0x5c98f6bc9d17ba0eb02e1336bdf035938f5859e5
# Provider keys (VITE_ALCHEMY_*_URL, VITE_ALCHEMY_API_KEY, VITE_ZEROX_API_KEY, VITE_BASE_WSS_URL)
# are set as Vercel environment variables, never committed. VITE_ values are embedded in the
# public bundle, so use domain-restricted keys.
